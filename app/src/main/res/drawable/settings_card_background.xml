<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorSurfaceContainerHigh" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#000000" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
</ripple>

<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <!-- roomier popup/dropdown menu rows (stock Android's default 48dp reads as cramped) -
             shared by every PopupMenu-backed menu in the app: the home screen icon's long-press
             menu and the settings toolbar's overflow menu -->
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <!-- PopupMenu item text size isn't controlled by popupMenuStyle at all (confirmed against
             AppCompat's abc_popup_menu_item_layout.xml) - only these two theme attrs reach it -->
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Launcher.PopupMenuItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Launcher.PopupMenuItem</item>
    </style>

    <style name="TextAppearance.Launcher.PopupMenuItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Launcher.PillPopupMenuItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- overrides Commons' same-named style (app-module resources win over library ones) with a
         bigger, bolder title closer to Material 3's Large Top App Bar treatment -->
    <style name="AppTheme.ActionBar.TitleTextStyle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Map settings text labels and switches to M3 tokens -->
    <style name="SettingsTextLabelStyle" parent="@style/TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingsTextValueStyle" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="SettingsNavRowTitleStyle" parent="SettingsTextLabelStyle">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- the few broad topic headings within a settings sub-screen, e.g. "Search"/"Layout" -->
    <style name="SettingsChapterHeadingStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- one per individual setting within a chapter, sitting above its own control -->
    <style name="SettingsSubHeadingStyle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SettingsSwitchStyle" parent="@style/TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- 64dp - a step beyond Material 3's 56dp one-line minimum, for the same more-generous,
         Lawnchair-like row rhythm applied across every settings screen. Horizontal padding is
         0dp here - the page itself now supplies the 20dp side inset (settings_page_padding), so
         rows don't double up on it -->
    <style name="SettingsHolderSwitchStyle" parent="@style/SettingsHolderSwitchStyle">
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="SettingsHolderTextViewStyle" parent="@style/SettingsHolderTextViewStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="SettingsHolderTextViewOneLinerStyle" parent="@style/SettingsHolderTextViewOneLinerStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- M3 Type Scale styles for launcher items & dialogs -->
    <style name="LauncherLabelStyle" parent="@style/TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/smaller_text_size</item>
    </style>

    <style name="WidgetSectionTitleStyle" parent="@style/TextAppearance.Material3.TitleMedium" />

    <style name="WidgetPreviewTitleStyle" parent="@style/TextAppearance.Material3.BodyMedium" />

    <style name="WidgetPreviewSizeStyle" parent="@style/TextAppearance.Material3.BodySmall" />

    <style name="LauncherTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu</item>
        <!-- roomier popup/dropdown menu rows - see AppTheme's copy of this item for why -->
        <item name="android:listPreferredItemHeightSmall">56dp</item>
        <!-- see AppTheme's copy of these two items for why -->
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Launcher.PopupMenuItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Launcher.PopupMenuItem</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

</resources>

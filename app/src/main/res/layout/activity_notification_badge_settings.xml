<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_badge_settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/notification_badge_settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/notification_badge_settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/notification_badges"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/notification_badge_settings_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/notification_badge_settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_page_padding"
            android:paddingTop="@dimen/settings_page_padding"
            android:paddingEnd="@dimen/settings_page_padding"
            android:paddingBottom="@dimen/settings_page_padding">

            <RelativeLayout
                android:id="@+id/settings_notification_badge_preview_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/settings_notification_badge_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/notification_badge_dot"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="16sp"
                    tools:text="9+" />

            </RelativeLayout>

            <TextView
                style="@style/SettingsChapterHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/notification_badges" />

            <RelativeLayout
                android:id="@+id/settings_show_notification_badges_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_background"
                android:minHeight="48dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_show_notification_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/notification_badges" />

            </RelativeLayout>

            <include
                layout="@layout/divider_inset"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SettingsSubHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/show_notification_count" />

            <RelativeLayout
                android:id="@+id/settings_show_notification_count_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_background"
                android:minHeight="48dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_show_notification_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

            </RelativeLayout>

            <include
                layout="@layout/divider_inset"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SettingsSubHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/notification_badge_color" />

            <RelativeLayout
                android:id="@+id/settings_notification_badge_color_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_background"
                android:minHeight="48dp">

                <View
                    android:id="@+id/settings_notification_badge_color"
                    android:layout_width="@dimen/color_sample_size"
                    android:layout_height="@dimen/color_sample_size"
                    android:layout_centerVertical="true"
                    android:background="@drawable/notification_badge_dot" />

            </RelativeLayout>

            <include
                layout="@layout/divider_inset"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SettingsSubHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/notification_badge_shape" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settings_notification_badge_shape_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/settings_chip_spacing"
                app:chipSpacingVertical="@dimen/settings_chip_spacing"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_notification_badge_shape_circle"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_badge_shape_circle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_notification_badge_shape_rounded_square"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_badge_shape_rounded_square" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_notification_badge_shape_sharp_square"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_badge_shape_sharp_square" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

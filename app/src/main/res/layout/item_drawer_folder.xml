<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_folder_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="5dp"
    android:paddingBottom="@dimen/small_margin">

    <ImageView
        android:id="@+id/drawer_folder_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/launcher_icon_size"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/drawer_folder_kebab"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignTop="@id/drawer_folder_icon"
        android:layout_alignEnd="@id/drawer_folder_icon"
        android:clickable="true"
        android:focusable="true"
        android:padding="3dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_three_dots_vector" />

    <TextView
        android:id="@+id/drawer_folder_label"
        style="@style/LauncherLabelStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/drawer_folder_icon"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/small_margin"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:maxLines="2"
        android:textStyle="bold" />

</RelativeLayout>

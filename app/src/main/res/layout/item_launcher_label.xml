<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="5dp"
    android:paddingBottom="@dimen/small_margin">

    <ImageView
        android:id="@+id/launcher_icon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/launcher_icon_size"
        android:layout_centerHorizontal="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/launcher_notification_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/launcher_icon"
        android:layout_alignEnd="@id/launcher_icon"
        android:background="@drawable/notification_badge_dot"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="10dp"
        android:minHeight="10dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:textSize="9sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/launcher_label"
        style="@style/LauncherLabelStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/launcher_icon"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/small_margin"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:maxLines="2" />

    <View
        android:id="@+id/popup_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|top" />

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/icon_settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/icon_settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/icon_settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/icons_subsection"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/icon_settings_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/icon_settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_page_padding"
            android:paddingTop="@dimen/settings_page_padding"
            android:paddingEnd="@dimen/settings_page_padding"
            android:paddingBottom="@dimen/settings_page_padding">

            <LinearLayout
                android:id="@+id/settings_icon_preview_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/settings_icon_preview"
                    android:layout_width="@dimen/icon_preview_size"
                    android:layout_height="@dimen/icon_preview_size"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/settings_icon_preview_label"
                    style="@style/SettingsTextLabelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:text="@string/icon_preview_label" />

            </LinearLayout>

            <TextView
                style="@style/SettingsChapterHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/icons_subsection" />

            <RelativeLayout
                android:id="@+id/settings_icon_pack_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_background"
                android:minHeight="48dp">

                <TextView
                    android:id="@+id/settings_icon_pack_label"
                    style="@style/SettingsSubHeadingStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_pack" />

                <TextView
                    android:id="@+id/settings_icon_pack"
                    style="@style/SettingsTextValueStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/settings_icon_pack_label"
                    android:layout_marginTop="4dp"
                    tools:text="System default" />

            </RelativeLayout>

            <include
                layout="@layout/divider_inset"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/SettingsSubHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/reshape_all_icons" />

            <RelativeLayout
                android:id="@+id/settings_reshape_all_icons_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_background"
                android:minHeight="48dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_reshape_all_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />

            </RelativeLayout>

            <include
                layout="@layout/divider_inset"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/settings_icon_shape_heading"
                style="@style/SettingsSubHeadingStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/icon_shape" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settings_icon_shape_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/settings_chip_spacing"
                app:chipSpacingVertical="@dimen/settings_chip_spacing"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_icon_shape_circle"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_shape_circle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_icon_shape_squircle"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_shape_squircle" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_icon_shape_ios"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_shape_ios" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_icon_shape_one_ui"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_shape_one_ui" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/settings_icon_shape_square"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icon_shape_square" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/smaller_margin"
    android:paddingEnd="@dimen/smaller_margin">

    <LinearLayout
        android:id="@+id/folder_contents_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/medium_margin"
        android:paddingBottom="@dimen/medium_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/medium_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folder_contents_title"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_weight="1"
                android:textStyle="bold"
                tools:text="Games" />

            <ImageView
                android:id="@+id/folder_contents_kebab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/activity_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_three_dots_vector" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folder_contents_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            app:layoutManager="org.fossify.commons.views.MyGridLayoutManager"
            app:spanCount="4" />

        <View
            android:id="@+id/folder_contents_popup_anchor"
            android:layout_width="0dp"
            android:layout_height="0dp" />

    </LinearLayout>

</FrameLayout>

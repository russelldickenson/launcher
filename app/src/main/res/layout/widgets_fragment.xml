<?xml version="1.0" encoding="utf-8"?>
<com.russelldickenson.lelauncher.fragments.WidgetsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgets_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.russelldickenson.lelauncher.views.SearchBarLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:applyWindowInsets="false" />

    <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller
        android:id="@+id/widgets_fastscroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_bar"
        app:fastScrollEnabled="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/widgets_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            app:layoutManager="com.russelldickenson.lelauncher.views.SafeLinearLayoutManager" />

    </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
</com.russelldickenson.lelauncher.fragments.WidgetsFragment>
